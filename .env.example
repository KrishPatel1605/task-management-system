# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (either set DATABASE_URL or the individual DB_* values)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/task_management
DB_HOST=localhost
DB_PORT=5432
DB_NAME=task_management
DB_USER=postgres
DB_PASSWORD=12345678

# JWT - use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=3f4d61fa73ddf77771286874474a84c960c439982791d7816bc06f36eee6cfb9bcc2b650d9c0e85b0a08c03592e3c043
JWT_EXPIRES_IN=1d

# bcrypt cost factor
BCRYPT_ROUNDS=10

# Seed users (used only by `npm run seed`; defaults are documented in the README)
SEED_ADMIN_PASSWORD=Admin@123
SEED_USER_PASSWORD=User@123
