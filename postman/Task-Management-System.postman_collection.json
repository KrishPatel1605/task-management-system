          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Role is user\", () => pm.expect(pm.response.json().data.user.role).to.eql(\"user\"));"
